{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cnc-monitor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "cnc-monitor-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "cnc-monitor-training-data",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CNC_DB_DIR=ml/data",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
